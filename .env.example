VAST_API_KEY=your_vast_api_key_here
VAST_SERVER_URL=https://console.vast.ai

# Transport options: stdio | httpStream
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8080

# Vast host integration
VAST_REQUEST_TIMEOUT_MS=30000
VAST_USE_CLI_FALLBACK=true
VAST_CLI_PATH=vastai

# Optional host automation flags
VAST_AUTO_PRICING_ENABLED=false
VAST_AUTO_RELIABILITY_GUARD=false

# Optional runtime logging
LOG_LEVEL=info
